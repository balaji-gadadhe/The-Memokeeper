# Discord Bot Authentication
DISCORD_TOKEN=your_bot_token_here

# The user whose messages should be captured (your Discord user id)
DISCORD_ALLOWED_USERS=your_user_id_here

# Optional: restrict capture to one server (your server id)
DISCORD_SERVER_ID=your_server_id_here

# Channel id -> category mapping (one per channel you want tracked;
# the part after DISCORD_CHANNEL_ becomes the category name)
DISCORD_CHANNEL_JOURNAL=your_channel_id_here
DISCORD_CHANNEL_COLLEGE=your_channel_id_here
DISCORD_CHANNEL_IDEAS_PROJECTS=your_channel_id_here
DISCORD_CHANNEL_TASKS=your_channel_id_here
DISCORD_CHANNEL_MISCELLANEOUS=your_channel_id_here

# Optional system channels (bot posts "captured / backfill done" notes here)
DISCORD_CHANNEL_LOG=your_log_channel_id_here
DISCORD_CHANNEL_ALERTS=your_alerts_channel_id_here

# Optional: relocate the data store (default ./data next to the scripts)
# MEMOKEEPER_DATA_DIR=D:\logs\memokeeper
